{
	"embeds": [
		{
			"title": ":rotating_light: FIRING: {{ .CommonAnnotations.summary }}",
			"description": "**📊 Reason:** {{ .CommonAnnotations.description }}\n\n**🗂 Group > Folder > Alert**\n🏠 **{{ .CommonLabels.group }}** > 🔴 **{{ .CommonLabels.grafana_folder }}** > 🌐 **{{ .CommonLabels.alertname }}**",
			"color": 16711680,
			"fields": [
				{
					"name": "📡 Service",
					"value": "{{ .CommonLabels.service }}",
					"inline": true
				},
				{
					"name": "📍 Instance",
					"value": "`{{ .CommonLabels.instance }}`",
					"inline": true
				},
				{
					"name": "🏷 Severity",
					"value": "`{{ .CommonLabels.severity }}`",
					"inline": true
				},
				{
					"name": "🔄 Job",
					"value": "`{{ .CommonLabels.job }}`",
					"inline": true
				},
				{
					"name": "🆔 Site ID",
					"value": "`{{ .CommonLabels.site_id }}`",
					"inline": true
				}
			],
			"footer": {
				"text": "Grafana Alert • {{ .Status }}",
				"icon_url": "https://grafana.com/static/img/logos/logo-wordmark.svg"
			}
		}
	],
	"components": [
		{
			"type": 1,
			"components": [
				{
					"type": 2,
					"label": "📢 View Alert",
					"style": 5,
					"url": "{{ with index .Alerts 0 }}{{ or .GeneratorURL $.ExternalURL }}{{ end }}"
				},
				{
					"type": 2,
					"label": "🔕 Silence Alert",
					"style": 5,
					"url": "{{ with index .Alerts 0 }}{{ .SilenceURL }}{{ end }}"
				},
				{
					"type": 2,
					"label": "📊 Dashboard",
					"style": 5,
					"url": "{{ with index .Alerts 0 }}{{ or .DashboardURL $.ExternalURL }}{{ end }}"
				},
				{
					"type": 2,
					"label": "📌 Panel",
					"style": 5,
					"url": "{{ with index .Alerts 0 }}{{ or .PanelURL $.ExternalURL }}{{ end }}"
				}
			]
		}
	]
}